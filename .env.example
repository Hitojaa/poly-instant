# Polymarket API (pas besoin de clé pour lire, mais utile pour trader)
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Wallet (Phantom - exporte ta clé privée depuis Phantom > Settings > Export Private Key)
WALLET_PRIVATE_KEY=

# Telegram Notifications (optionnel)
# 1. Parle a @BotFather sur Telegram -> /newbot -> recupere le token
# 2. Envoie un message a ton bot
# 3. Va sur https://api.telegram.org/bot<TOKEN>/getUpdates pour trouver ton chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Etherscan API V2 (RECOMMANDE pour le wallet tracker + on-chain data)
# Polygonscan utilise maintenant Etherscan V2 avec chainid=137
# 1. Cree un compte sur https://etherscan.io
# 2. Genere une API key (My API Keys)
# 3. Cette meme cle marche pour Polygon, Arbitrum, BSC, etc.
POLYGONSCAN_API_KEY=

# Config
SCAN_INTERVAL=60
MIN_PROFIT_PCT=2.0
